# =============================================================================
# .env.example — Smart Observability and AIOps Platform (CICADA 2026)
#
# Copy to `.env` and edit:   cp .env.example .env
# NEVER commit `.env`. NEVER put real credentials in this example file.
# Every value below is a development placeholder only.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
APP_ENV=development                 # development | demo | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                     # structured logging
LOG_DIR=./logs
TZ=UTC                              # containers run in UTC; timestamps are UTC

# -----------------------------------------------------------------------------
# PostgreSQL (centralized SaaS database)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=observability
POSTGRES_USER=obs_user
POSTGRES_PASSWORD=change-me-dev-only
# Full SQLAlchemy URL used by the backend (keep consistent with the values above)
DATABASE_URL=postgresql+psycopg2://obs_user:change-me-dev-only@postgres:5432/observability

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_PUBLIC_URL=http://localhost:8000
# Region this backend instance serves (regional ingestion / data residency demo)
REGION_ID=ap-south-1
# Allowed browser origins for the dashboard (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Secret used to sign dashboard/user tokens. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-generated-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Secret used to hash collector tokens at rest. Generate your own as above.
COLLECTOR_TOKEN_HASH_SALT=replace-with-generated-salt

# Maximum accepted payload size in bytes
MAX_PAYLOAD_BYTES=262144

# -----------------------------------------------------------------------------
# Reliability and timing (targets from the evaluation guide; measure, don't assume)
# -----------------------------------------------------------------------------
HEARTBEAT_INTERVAL_SECONDS=5
# A collector is flagged offline when no heartbeat for this long.
# Target: offline detection within 60 seconds of the last heartbeat.
OFFLINE_THRESHOLD_SECONDS=45
OFFLINE_CHECK_INTERVAL_SECONDS=5
# Data older than this is treated as stale in health classification
STALE_DATA_SECONDS=15
# Accept events whose event time is up to this far behind ingest time (out-of-order)
OUT_OF_ORDER_TOLERANCE_SECONDS=300

# -----------------------------------------------------------------------------
# AIOps engine
# -----------------------------------------------------------------------------
AIOPS_BASELINE_WINDOW=120           # number of recent samples used for baseline
AIOPS_MIN_BASELINE_SAMPLES=30       # do not flag anomalies before this many samples
AIOPS_ZSCORE_THRESHOLD=3.0
AIOPS_CORRELATION_WINDOW_SECONDS=60
AIOPS_ENABLE_ISOLATION_FOREST=false # optional bonus
# Health classification thresholds (configurable; documented in HEALTH_CLASSIFICATION.md)
HEALTH_CONFIG_PATH=./aiops-engine/config/health.yaml
# Autonomous Ops is simulated / safe-test-only
AUTONOMOUS_OPS_MODE=simulate        # simulate | off

# -----------------------------------------------------------------------------
# Collector (runs in the "local customer environment")
# -----------------------------------------------------------------------------
COLLECTOR_ID=collector-demo-001
COLLECTOR_TENANT_ID=tenant-a
# Token issued by the seed/registration script. Placeholder only; replace before use.
# For production, generate a 32-byte token with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
COLLECTOR_TOKEN=replace-with-token-from-seed-script
COLLECTOR_VERSION=0.1.0
COLLECTOR_SOURCE_TIMEZONE=Asia/Kolkata
SAAS_BASE_URL=http://localhost:8000
# Local-only data (raw logs, buffer, audit) — never uploaded
COLLECTOR_DATA_DIR=./collector-data
COLLECTOR_SQLITE_PATH=./collector-data/collector.db
COLLECTOR_LOCAL_RETENTION_HOURS=24
COLLECTOR_COLLECT_INTERVAL_SECONDS=5
COLLECTOR_SEND_INTERVAL_SECONDS=5
COLLECTOR_AGGREGATION_WINDOW_SECONDS=5
COLLECTOR_QUEUE_MAX_MB=100
COLLECTOR_SEND_BATCH_SIZE=50
# Retry with exponential backoff
RETRY_INITIAL_DELAY_SECONDS=1
RETRY_MAX_DELAY_SECONDS=60
RETRY_BACKOFF_FACTOR=2
RETRY_JITTER_SECONDS=0.5
# Salt used to create pseudonymous source identifiers. Generate at least 32 random bytes.
# Production rejects placeholders, salts shorter than 32 bytes, and low-diversity values.
PSEUDONYM_SALT=replace-with-generated-salt
# Path to the field allow-list and redaction rules
ALLOWLIST_PATH=./shared/allowlist.json
REDACTION_RULES_PATH=./shared/redaction_rules.json
# Local development may use HTTP only with localhost, 127.0.0.1, or ::1.
# Production requires an HTTPS URL and certificate verification. Set true and optionally
# provide a trusted CA bundle path for a private CA.
SAAS_VERIFY_TLS=false
SAAS_CA_BUNDLE_PATH=

# -----------------------------------------------------------------------------
# Telemetry generator (demo / test only)
# -----------------------------------------------------------------------------
GENERATOR_MODE=normal               # normal | cpu_spike | memory_spike | latency_spike | packet_loss | failed_logins | sensitive | out_of_order
GENERATOR_SEED=42                   # fixed seed for repeatable demos

# -----------------------------------------------------------------------------
# Frontend (Vite — only variables prefixed VITE_ reach the browser; never put secrets here)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_USE_MOCK=false                 # true = use sample-data JSON instead of the backend
VITE_POLL_INTERVAL_MS=5000

# -----------------------------------------------------------------------------
# Seed / demo data
# -----------------------------------------------------------------------------
SEED_TENANT_A_NAME=Tenant A
SEED_TENANT_B_NAME=Tenant B
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=change-me-dev-only
